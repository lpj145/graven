namespace bank;

enum Currency : u16 { BRL = 0, USD = 1, EUR = 2 }

table Entry {
  account @0: u64;
  amount  @1: i64;
  memo    @2: string?;
}

// v3 (mirrors graven-schemas/schemas/evo/bank_v3.graven) with the break confirmed in the schema.
table Transaction {
  id         @0: u64;
  ts         @1: u64;
  currency   @2: Currency;
  #[allow_breaking_readers] from_shard @3: u32?; // was required (required-relaxed)
  #[allow_breaking_readers] @4: reserved;           // was `to_shard @4: u32` (required)
  entries    @5: [Entry];
  @6: reserved string;     // was `note @6: string?`
  fee        @7: i64?;
}
